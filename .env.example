# ============================================================
# my_repos/.env  (copie de .env.example e NUNCA versione o .env)
# Convenção: GH_<ALIAS>_<CAMPO>, alias em MAIÚSCULAS (hífen vira _)
# ============================================================

# Lista de aliases (minúsculos, separados por espaço) -> viram pastas em my_repos/
GH_USERS="mdelapi"

# Usuário ativo por padrão (usado quando o alias não é informado)
GH_DEFAULT="mdelapi"

# ---------- usuário: mdelapi ----------
GH_MDELAPI_USER="mdelapi"                       # login do GitHub
GH_MDELAPI_NAME="Seu Nome"                      # git user.name
GH_MDELAPI_EMAIL="seu-email@exemplo.com"        # git user.email
GH_MDELAPI_SSH_KEY="$HOME/.ssh/id_ed25519_mdelapi"  # opcional (preferido p/ push)
GH_MDELAPI_TOKEN=""                             # opcional: PAT p/ HTTPS (repos privados)

# ---------- exemplo de segundo usuário ----------
# GH_USERS="mdelapi outro-user"
# GH_OUTRO_USER_USER="outro-user"
# GH_OUTRO_USER_NAME="Outro Nome"
# GH_OUTRO_USER_EMAIL="outro@exemplo.com"
# GH_OUTRO_USER_SSH_KEY="$HOME/.ssh/id_ed25519_outro"
# GH_OUTRO_USER_TOKEN=""
